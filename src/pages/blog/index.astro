---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PremiumPage from '../../components/PremiumPage.astro';
import MascotStatusBar from '../../components/MascotStatusBar.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { withBase } from '../../utils/path';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<PremiumPage title={`文章 · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<MascotStatusBar line="文章列表 · 背景看板娘缓慢漂移虚化中" />

	<section class="glass-panel blog-panel">
		<h1>文章</h1>
		<ul>
			{
				posts.map((post) => (
					<li>
						<a href={withBase(`/blog/${post.id}/`)}>
							{post.data.heroImage && (
								<Image width={720} height={360} src={post.data.heroImage} alt="" />
							)}
							<h2 class="title">{post.data.title}</h2>
							<p class="date">
								<FormattedDate date={post.data.pubDate} />
							</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</PremiumPage>

<style>
	.blog-panel {
		padding: 1.5rem 1.5rem 2rem;
	}

	.blog-panel h1 {
		margin-bottom: 1.25rem;
		font-size: 1.65rem;
	}

	ul {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	ul li a {
		display: block;
		text-decoration: none;
		transition: transform 0.15s ease;
	}

	ul li a:hover {
		transform: translateY(-2px);
	}

	ul li img {
		margin-bottom: 0.65rem;
		border-radius: 12px;
		border: 1px solid rgba(212, 175, 55, 0.15);
		opacity: 0.92;
	}

	.title {
		margin: 0;
		font-size: 1.05rem;
		color: rgba(232, 230, 227, 0.96);
		line-height: 1.35;
		font-family: var(--font-display);
	}

	.date {
		margin: 0.35rem 0 0;
		color: rgba(156, 163, 175, 0.9);
		font-size: 0.85rem;
	}

	ul li a:hover .title {
		color: var(--accent-2);
	}
</style>
