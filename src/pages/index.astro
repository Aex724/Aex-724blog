---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AnimeNavButton from '../components/AnimeNavButton.astro';
import mascot from '../assets/mascot-anime.png';
import {
	SITE_DESCRIPTION,
	SITE_TITLE,
	GITHUB_SMARTCAR,
	GITHUB_BLOG,
	GITHUB_USER,
} from '../consts';
import { withBase } from '../utils/path';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="stage">
				<div class="mascot-wrap">
					<div class="bubble" id="mascot-bubble" role="status" aria-live="polite">
						<p id="mascot-line">欢迎来到 Aex724 的技术博客～点右边按钮出发吧！</p>
					</div>
					<div class="mascot-frame">
						<Image
							src={mascot}
							alt="博客看板娘形象"
							width={420}
							height={560}
							class="mascot-img"
							loading="eager"
						/>
					</div>
				</div>

				<div class="menu-panel">
					<p class="menu-title">✦ 导航菜单 ✦</p>
					<div class="nav-grid" id="nav-grid">
						<AnimeNavButton href="/blog/" label="文章" emoji="📖" hint="要去看看我写的技术文章吗？" />
						<AnimeNavButton href="/about/" label="关于" emoji="💫" hint="这里是我的自我介绍哦～" />
						<AnimeNavButton
							href={GITHUB_SMARTCAR}
							label="智能车"
							emoji="🚗"
							hint="智慧工厂 ROS 工程在这边！"
							external
						/>
						<AnimeNavButton
							href={`https://github.com/${GITHUB_USER}`}
							label="GitHub"
							emoji="🐙"
							hint="我的开源仓库都在这里～"
							external
						/>
						<AnimeNavButton
							href={GITHUB_BLOG}
							label="博客源码"
							emoji="🌸"
							hint="这个网站本身也是开源的！"
							external
						/>
						<AnimeNavButton href="/blog/smartcar-21-wisdom-factory/" label="项目说明" emoji="📝" hint="智能车仓库的使用说明在这篇～" />
					</div>
				</div>
			</section>

			<section class="section" id="projects">
				<h2>项目卡片</h2>
				<div class="project-grid">
					<article class="card project">
						<h3>21 届智能车 · 智慧工厂</h3>
						<p>ROS 工作空间：导航、视觉、语音与 Gazebo 仿真。</p>
						<a href={GITHUB_SMARTCAR} target="_blank" rel="noopener noreferrer">打开 GitHub 仓库 →</a>
					</article>
					<article class="card project">
						<h3>博客 · Astro</h3>
						<p>Push 后自动部署到 GitHub Pages。</p>
						<a href={withBase('/blog/welcome/')}>阅读欢迎文章 →</a>
					</article>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const line = document.getElementById('mascot-line');
			const defaultText = '欢迎来到 Aex724 的技术博客～点右边按钮出发吧！';
			const buttons = document.querySelectorAll('#nav-grid .nav-btn');

			buttons.forEach((btn) => {
				const hint = btn.getAttribute('data-hint');
				if (!hint || !line) return;

				btn.addEventListener('mouseenter', () => {
					line.textContent = hint;
				});
				btn.addEventListener('focus', () => {
					line.textContent = hint;
				});
				btn.addEventListener('click', () => {
					line.textContent = hint + ' 正在跳转…';
				});
			});

			document.getElementById('nav-grid')?.addEventListener('mouseleave', () => {
				if (line) line.textContent = defaultText;
			});
		</script>
	</body>
</html>

<style>
	.home {
		width: min(1040px, calc(100% - 2em));
	}

	.stage {
		display: grid;
		grid-template-columns: minmax(240px, 1fr) minmax(280px, 1.05fr);
		gap: 1.5rem;
		align-items: end;
		margin-bottom: 2.5rem;
	}

	.mascot-wrap {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.bubble {
		position: relative;
		max-width: 22rem;
		margin-bottom: 0.75rem;
		padding: 0.85rem 1.1rem;
		background: #fff;
		border: 2px solid rgba(244, 114, 182, 0.55);
		border-radius: 20px;
		box-shadow: 0 8px 24px rgba(236, 72, 153, 0.15);
		animation: float 3s ease-in-out infinite;
	}

	.bubble::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: -10px;
		width: 18px;
		height: 18px;
		background: #fff;
		border-right: 2px solid rgba(244, 114, 182, 0.55);
		border-bottom: 2px solid rgba(244, 114, 182, 0.55);
		transform: translateX(-50%) rotate(45deg);
	}

	.bubble p {
		margin: 0;
		font-size: 0.95rem;
		color: #6b2144;
		line-height: 1.55;
	}

	.mascot-frame {
		width: min(100%, 320px);
		filter: drop-shadow(0 16px 28px rgba(168, 85, 247, 0.25));
	}

	.mascot-img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 24px;
		border: 3px solid rgba(255, 255, 255, 0.85);
	}

	.menu-panel {
		background: rgba(255, 255, 255, 0.75);
		backdrop-filter: blur(8px);
		border: 2px solid rgba(244, 114, 182, 0.35);
		border-radius: 24px;
		padding: 1.25rem;
		box-shadow: var(--box-shadow);
	}

	.menu-title {
		text-align: center;
		margin: 0 0 1rem;
		font-family: var(--font-display);
		color: #a21caf;
		font-size: 1.15rem;
	}

	.nav-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.85rem;
	}

	.section h2 {
		margin-bottom: 1rem;
		color: #86198f;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1rem;
	}

	.project h3 {
		margin-bottom: 0.5rem;
	}

	.project p {
		font-size: 0.92rem;
		color: rgb(var(--gray));
		margin-bottom: 0.75rem;
	}

	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
	}

	@media (max-width: 820px) {
		.stage {
			grid-template-columns: 1fr;
		}

		.mascot-wrap {
			order: -1;
		}

		.nav-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 420px) {
		.nav-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
