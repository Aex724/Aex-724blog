---
import PremiumPage from '../components/PremiumPage.astro';
import AnimeNavButton from '../components/AnimeNavButton.astro';
import MascotStatusBar from '../components/MascotStatusBar.astro';
import {
	SITE_DESCRIPTION,
	SITE_TITLE,
	GITHUB_SMARTCAR,
	GITHUB_BLOG,
	GITHUB_USER,
} from '../consts';
import { withBase } from '../utils/path';
---

<PremiumPage title={SITE_TITLE} description={SITE_DESCRIPTION} mainClass="home-main">
	<section class="hero glass-panel">
		<p class="kicker">AEX724 · TECH BLOG</p>
		<h1>执剑写码，静水深流</h1>
		<p class="subtitle">{SITE_DESCRIPTION}</p>

		<MascotStatusBar
			lineId="mascot-line"
			line="青绿柔光 · Fuwari 风配色 · 择一入口继续"
		/>

		<div class="nav-grid" id="nav-grid">
			<AnimeNavButton href="/blog/" label="文章" emoji="📜" hint="前往文章列表，阅读技术记录。" />
			<AnimeNavButton href="/about/" label="关于" emoji="✦" hint="了解 Aex724 与项目方向。" />
			<AnimeNavButton
				href={GITHUB_SMARTCAR}
				label="智能车"
				emoji="⚔"
				hint="21 届智慧工厂 ROS 工程仓库。"
				external
			/>
			<AnimeNavButton
				href={`https://github.com/${GITHUB_USER}`}
				label="GitHub"
				emoji="⌁"
				hint="全部开源仓库入口。"
				external
			/>
			<AnimeNavButton
				href={GITHUB_BLOG}
				label="源码"
				emoji="◇"
				hint="本站 Astro 源码。"
				external
			/>
			<AnimeNavButton
				href="/blog/smartcar-21-wisdom-factory/"
				label="说明"
				emoji="→"
				hint="智能车仓库使用说明文章。"
			/>
		</div>
	</section>

	<section class="projects">
		<article class="card">
			<h3>21 届智能车 · 智慧工厂</h3>
			<p>ROS 工作空间：导航、视觉、语音、Gazebo 仿真。</p>
			<a href={GITHUB_SMARTCAR} target="_blank" rel="noopener noreferrer">Repository →</a>
		</article>
		<article class="card">
			<h3>博客 · Astro</h3>
			<p>Push 后 GitHub Actions 自动部署 Pages。</p>
			<a href={withBase('/blog/welcome/')}>Welcome post →</a>
		</article>
	</section>

	<script>
		const line = document.getElementById('mascot-line');
		const defaultText = '青绿柔光 · Fuwari 风配色 · 择一入口继续';
		document.querySelectorAll('#nav-grid .nav-btn').forEach((btn) => {
			const hint = btn.getAttribute('data-hint');
			if (!hint || !line) return;
			btn.addEventListener('mouseenter', () => {
				line.textContent = hint;
			});
			btn.addEventListener('focus', () => {
				line.textContent = hint;
			});
		});
		document.getElementById('nav-grid')?.addEventListener('mouseleave', () => {
			if (line) line.textContent = defaultText;
		});
	</script>
</PremiumPage>

<style>
	.hero {
		padding: 2rem 1.75rem 1.75rem;
		text-align: center;
	}

	.kicker {
		margin: 0 0 0.75rem;
		font-size: 0.72rem;
		letter-spacing: 0.28em;
		color: rgba(57, 197, 187, 0.9);
	}

	.hero h1 {
		margin-bottom: 0.65rem;
		font-size: clamp(1.85rem, 4vw, 2.65rem);
		background: linear-gradient(120deg, #ecfdf9 0%, #39c5bb 55%, #7dd3c8 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.subtitle {
		max-width: 32rem;
		margin: 0 auto 0.5rem;
		color: rgba(156, 163, 175, 0.95);
		font-size: 0.95rem;
	}

	.nav-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
		margin-top: 0.25rem;
	}

	.projects {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1rem;
		margin-top: 1.25rem;
	}

	.projects h3 {
		font-size: 1.05rem;
		margin-bottom: 0.45rem;
	}

	.projects p {
		font-size: 0.9rem;
		color: rgba(156, 163, 175, 0.95);
		margin-bottom: 0.65rem;
	}

	.projects a {
		font-size: 0.82rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	@media (max-width: 720px) {
		.nav-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.hero {
			padding: 1.5rem 1.15rem;
		}
	}
</style>
