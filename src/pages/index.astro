---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	SITE_DESCRIPTION,
	SITE_TITLE,
	GITHUB_SMARTCAR,
	GITHUB_BLOG,
} from '../consts';
import { withBase } from '../utils/path';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Personal Tech Blog</p>
				<h1>
					<span class="gradient">Aex724</span> 的技术空间
				</h1>
				<p class="lead">
					{SITE_DESCRIPTION}。在这里写笔记、记录比赛项目，并把代码放在 GitHub 上长期维护。
				</p>
				<div class="hero-actions">
					<a class="btn" href={withBase('/blog/')}>阅读文章</a>
					<a class="btn btn-ghost" href={withBase('/about/')}>关于我</a>
				</div>
			</section>

			<section class="section">
				<h2>项目</h2>
				<div class="project-grid">
					<article class="card project">
						<div class="project-icon" aria-hidden="true">🚗</div>
						<h3>21 届智能车 · 智慧工厂</h3>
						<p>
							讯飞创意组 ROS 工作空间：导航、视觉、语音、Gazebo 仿真等。代码已开源在独立仓库，体积较大的语音资源需按文档本地补全。
						</p>
						<a class="project-link" href={GITHUB_SMARTCAR} target="_blank" rel="noopener noreferrer">
							GitHub → smartcar-21-wisdom-factory
						</a>
					</article>
					<article class="card project">
						<div class="project-icon" aria-hidden="true">✨</div>
						<h3>本博客站点</h3>
						<p>
							使用 Astro 构建，通过 GitHub Actions 部署到 GitHub Pages。文章在
							<code>src/content/blog/</code>，改完 push 即自动更新。
						</p>
						<a class="project-link" href={GITHUB_BLOG} target="_blank" rel="noopener noreferrer">
							GitHub → Aex-724blog
						</a>
					</article>
				</div>
			</section>

			<section class="section">
				<h2>最近在写</h2>
				<p class="muted">
					进入 <a href={withBase('/blog/')}>文章列表</a> 查看全部。你可以在本地用
					<code>npm run dev</code> 预览修改。
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 2.5rem 0 2rem;
		text-align: center;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.75rem;
		color: var(--accent);
		margin: 0 0 1rem;
		font-weight: 600;
	}

	.hero h1 {
		font-size: clamp(2rem, 5vw, 2.85rem);
		margin-bottom: 1rem;
	}

	.gradient {
		background: linear-gradient(120deg, #38bdf8, #818cf8);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.lead {
		max-width: 36em;
		margin: 0 auto 1.75rem;
		color: rgb(148, 163, 184);
		font-size: 1.05rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
	}

	.section {
		margin-top: 2.5rem;
	}

	.section h2 {
		margin-bottom: 1.25rem;
		font-size: 1.35rem;
		color: rgb(226, 232, 240);
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.25rem;
	}

	.project h3 {
		margin: 0.5rem 0 0.75rem;
		font-size: 1.15rem;
	}

	.project p {
		margin: 0 0 1rem;
		font-size: 0.95rem;
		color: rgb(148, 163, 184);
		line-height: 1.65;
	}

	.project-icon {
		font-size: 1.75rem;
	}

	.project-link {
		font-weight: 600;
		font-size: 0.9rem;
		word-break: break-all;
	}

	.muted {
		color: rgb(100, 116, 139);
		font-size: 0.95rem;
	}
</style>
