---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AnimeNavButton from '../components/AnimeNavButton.astro';
import MascotShowcase from '../components/MascotShowcase.astro';
import {
	SITE_DESCRIPTION,
	SITE_TITLE,
	GITHUB_SMARTCAR,
	GITHUB_BLOG,
	GITHUB_USER,
} from '../consts';
import { withBase } from '../utils/path';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home page-shell">
			<section class="stage">
				<MascotShowcase
					variant="hero"
					bubbleId="mascot-bubble"
					lineId="mascot-line"
					line="欢迎回来～我是国风看板娘，短发异瞳、执剑护站。点右侧按钮去逛逛吧！"
				/>

				<div class="menu-panel">
					<p class="menu-title">✦ 导航菜单 ✦</p>
					<div class="nav-grid" id="nav-grid">
						<AnimeNavButton href="/blog/" label="文章" emoji="📖" hint="要去看技术文章吗？我陪你去～" />
						<AnimeNavButton href="/about/" label="关于" emoji="💫" hint="关于页也有我站岗哦！" />
						<AnimeNavButton
							href={GITHUB_SMARTCAR}
							label="智能车"
							emoji="🚗"
							hint="智慧工厂 ROS 工程，利剑出鞘！"
							external
						/>
						<AnimeNavButton
							href={`https://github.com/${GITHUB_USER}`}
							label="GitHub"
							emoji="🐙"
							hint="开源仓库在这边～"
							external
						/>
						<AnimeNavButton
							href={GITHUB_BLOG}
							label="博客源码"
							emoji="🌸"
							hint="网站源码，随你改～"
							external
						/>
						<AnimeNavButton
							href="/blog/smartcar-21-wisdom-factory/"
							label="项目说明"
							emoji="📝"
							hint="智能车仓库说明在这篇～"
						/>
					</div>
				</div>
			</section>

			<section class="section" id="projects">
				<h2>项目卡片</h2>
				<div class="project-grid">
					<article class="card project">
						<h3>21 届智能车 · 智慧工厂</h3>
						<p>ROS 工作空间：导航、视觉、语音与 Gazebo 仿真。</p>
						<a href={GITHUB_SMARTCAR} target="_blank" rel="noopener noreferrer">打开 GitHub 仓库 →</a>
					</article>
					<article class="card project">
						<h3>博客 · Astro</h3>
						<p>Push 后自动部署到 GitHub Pages。</p>
						<a href={withBase('/blog/welcome/')}>阅读欢迎文章 →</a>
					</article>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const line = document.getElementById('mascot-line');
			const defaultText =
				'欢迎回来～我是国风看板娘，短发异瞳、执剑护站。点右侧按钮去逛逛吧！';
			const buttons = document.querySelectorAll('#nav-grid .nav-btn');

			buttons.forEach((btn) => {
				const hint = btn.getAttribute('data-hint');
				if (!hint || !line) return;

				btn.addEventListener('mouseenter', () => {
					line.textContent = hint;
				});
				btn.addEventListener('focus', () => {
					line.textContent = hint;
				});
				btn.addEventListener('click', () => {
					line.textContent = hint + ' 正在跳转…';
				});
			});

			document.getElementById('nav-grid')?.addEventListener('mouseleave', () => {
				if (line) line.textContent = defaultText;
			});
		</script>
	</body>
</html>

<style>
	.home {
		width: min(1040px, calc(100% - 2em));
	}

	.stage {
		display: grid;
		grid-template-columns: minmax(240px, 1fr) minmax(280px, 1.05fr);
		gap: 1.5rem;
		align-items: end;
		margin-bottom: 2.5rem;
	}

	.menu-panel {
		background: rgba(255, 255, 255, 0.75);
		backdrop-filter: blur(8px);
		border: 2px solid rgba(244, 114, 182, 0.35);
		border-radius: 24px;
		padding: 1.25rem;
		box-shadow: var(--box-shadow);
	}

	.menu-title {
		text-align: center;
		margin: 0 0 1rem;
		font-family: var(--font-display);
		color: #a21caf;
		font-size: 1.15rem;
	}

	.nav-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.85rem;
	}

	.section h2 {
		margin-bottom: 1rem;
		color: #86198f;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1rem;
	}

	.project h3 {
		margin-bottom: 0.5rem;
	}

	.project p {
		font-size: 0.92rem;
		color: rgb(var(--gray));
		margin-bottom: 0.75rem;
	}

	@media (max-width: 820px) {
		.stage {
			grid-template-columns: 1fr;
		}

		.nav-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 420px) {
		.nav-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
