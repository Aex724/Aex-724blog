---
interface Props {
	line?: string;
	lineId?: string;
}

const { line = '青绿柔光护站中 · 择一入口继续', lineId } = Astro.props;
---

<div class="status-bar">
	<span class="dot" aria-hidden="true"></span>
	<p {...lineId ? { id: lineId } : {}}>{line}</p>
</div>

<style>
	.status-bar {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		max-width: 36rem;
		margin: 0 auto 1.5rem;
		padding: 0.85rem 1.1rem;
		border-radius: 16px;
		background: rgba(10, 28, 32, 0.55);
		border: 1px solid rgba(57, 197, 187, 0.28);
		backdrop-filter: blur(14px);
		box-shadow: 0 12px 40px rgba(8, 40, 42, 0.35);
	}

	.dot {
		flex-shrink: 0;
		width: 8px;
		height: 8px;
		margin-top: 0.45rem;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 14px rgba(57, 197, 187, 0.9);
		animation: pulse 2.4s ease-in-out infinite;
	}

	.status-bar p {
		margin: 0;
		font-size: 0.92rem;
		color: rgba(236, 253, 250, 0.92);
		line-height: 1.6;
		letter-spacing: 0.02em;
	}

	@keyframes pulse {
		0%,
		100% {
			opacity: 0.65;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.15);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dot {
			animation: none;
		}
	}
</style>
