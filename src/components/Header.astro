---
import { SITE_TITLE, GITHUB_USER, GITHUB_BLOG } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><HeaderLink href="/">{SITE_TITLE}</HeaderLink></h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<div class="social-links">
			<a href={`https://github.com/${GITHUB_USER}`} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href={GITHUB_BLOG} target="_blank" rel="noopener noreferrer" class="repo-link" title="博客源码">
				<span aria-hidden="true">⌘</span>
				<span class="repo-label">Blog</span>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		margin: 0;
		padding: 0 1.25em;
		background: rgba(8, 12, 24, 0.82);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(51, 65, 85, 0.6);
	}

	h2 {
		margin: 0;
		font-size: 1.15em;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	h2 :global(a) {
		color: rgb(226, 232, 240);
		text-decoration: none;
	}

	h2 :global(a.active) {
		color: var(--accent);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 920px;
		margin: 0 auto;
		min-height: 3.25rem;
	}

	.internal-links {
		display: flex;
		gap: 0.25rem;
	}

	nav :global(a) {
		padding: 0.65em 0.85em;
		color: rgb(148, 163, 184);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.95rem;
	}

	nav :global(a:hover) {
		color: rgb(226, 232, 240);
	}

	nav :global(a.active) {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.social-links a {
		color: rgb(148, 163, 184);
		display: flex;
		align-items: center;
	}

	.social-links a:hover {
		color: var(--accent);
	}

	.repo-link {
		font-size: 0.8rem;
		padding: 0.35em 0.65em;
		border-radius: 8px;
		border: 1px solid rgba(51, 65, 85, 0.8);
		gap: 0.35em;
	}

	.repo-label {
		font-weight: 600;
	}

	@media (max-width: 720px) {
		.repo-label {
			display: none;
		}

		.internal-links {
			gap: 0;
		}

		nav :global(a) {
			padding: 0.5em 0.45em;
			font-size: 0.88rem;
		}
	}
</style>
