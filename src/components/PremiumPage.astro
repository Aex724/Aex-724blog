---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import SiteBackdrop from './SiteBackdrop.astro';
import MascotFigure from './MascotFigure.astro';

interface Props {
	title: string;
	description: string;
	mainClass?: string;
}

const { title, description, mainClass = '' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<SiteBackdrop />
		<MascotFigure />
		<div class="site-shell">
			<Header />
			<main class:list={['page-main', mainClass]}>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	.site-shell {
		position: relative;
		z-index: 2;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.page-main {
		flex: 1;
		width: min(980px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 1.5rem 0 min(42vh, 460px);
	}
</style>
