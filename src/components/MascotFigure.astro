---
import { Image } from 'astro:assets';
import mascot from '../assets/mascot-cn.png';
---

<div class="mascot-figure" aria-hidden="true">
	<Image
		src={mascot}
		alt=""
		width={480}
		height={640}
		class="figure-img"
		loading="eager"
		decoding="async"
	/>
</div>

<style>
	.mascot-figure {
		position: fixed;
		left: 50%;
		bottom: -2vh;
		z-index: 1;
		width: min(42vw, 320px);
		max-height: 62vh;
		transform: translateX(-50%);
		pointer-events: none;
		animation: figure-sway 8s ease-in-out infinite;
		filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.45));
	}

	.figure-img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: contain;
		object-position: bottom center;
		mask-image: linear-gradient(180deg, #000 78%, transparent 100%);
		-webkit-mask-image: linear-gradient(180deg, #000 78%, transparent 100%);
	}

	@keyframes figure-sway {
		0%,
		100% {
			transform: translateX(-50%) translateY(0);
		}
		50% {
			transform: translateX(calc(-50% + 6px)) translateY(-10px);
		}
	}

	@media (max-width: 900px) {
		.mascot-figure {
			width: min(56vw, 280px);
			opacity: 0.88;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mascot-figure {
			animation: none;
		}
	}
</style>
