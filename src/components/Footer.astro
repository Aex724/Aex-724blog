---
import { SITE_TITLE, GITHUB_USER, GITHUB_SMARTCAR } from '../consts';

const today = new Date();
---

<footer>
	<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}. 记录代码与比赛。</p>
	<p class="links">
		<a href={`https://github.com/${GITHUB_USER}`} target="_blank" rel="noopener noreferrer">GitHub</a>
		<span aria-hidden="true">·</span>
		<a href={GITHUB_SMARTCAR} target="_blank" rel="noopener noreferrer">智能车工程</a>
	</p>
</footer>
<style>
	footer {
		padding: 2.5em 1em 4em;
		text-align: center;
		border-top: 1px solid rgba(51, 65, 85, 0.5);
		background: rgba(8, 12, 24, 0.6);
	}

	.copy {
		margin: 0 0 0.5em;
		color: rgb(100, 116, 139);
		font-size: 0.9rem;
	}

	.links {
		margin: 0;
		font-size: 0.9rem;
	}

	.links a {
		color: rgb(148, 163, 184);
	}

	.links a:hover {
		color: var(--accent);
	}

	.links span {
		margin: 0 0.5em;
		color: rgb(71, 85, 105);
	}
</style>
