---
import { SITE_TITLE, GITHUB_USER, GITHUB_SMARTCAR } from '../consts';

const today = new Date();
---

<footer>
	<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}</p>
	<p class="links">
		<a href={`https://github.com/${GITHUB_USER}`} target="_blank" rel="noopener noreferrer">GitHub</a>
		<span aria-hidden="true">·</span>
		<a href={GITHUB_SMARTCAR} target="_blank" rel="noopener noreferrer">Smartcar</a>
	</p>
</footer>
<style>
	footer {
		padding: 2rem 1rem 2.75rem;
		text-align: center;
		border-top: 1px solid rgba(212, 175, 55, 0.1);
		background: linear-gradient(180deg, transparent, rgba(5, 6, 8, 0.65));
	}

	.copy {
		margin: 0 0 0.4rem;
		color: rgba(156, 163, 175, 0.85);
		font-size: 0.82rem;
		letter-spacing: 0.06em;
	}

	.links {
		margin: 0;
		font-size: 0.82rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.links a {
		color: rgba(212, 175, 55, 0.85);
	}

	.links a:hover {
		color: #fff;
	}

	.links span {
		margin: 0 0.45em;
		color: rgba(100, 116, 139, 0.8);
	}
</style>
