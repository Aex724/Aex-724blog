---
import { getImage } from 'astro:assets';
import mascot from '../assets/mascot-cn.png';

const bg = await getImage({ src: mascot, width: 1920, height: 2560, format: 'webp', quality: 80 });
---

<div class="site-backdrop" aria-hidden="true">
	<div class="layer layer-a" style={`background-image: url(${bg.src})`}></div>
	<div class="layer layer-b" style={`background-image: url(${bg.src})`}></div>
	<div class="veil"></div>
	<div class="grain"></div>
</div>

<style>
	.site-backdrop {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		background: #050608;
		pointer-events: none;
	}

	.layer {
		position: absolute;
		inset: -8%;
		background-size: cover;
		background-position: center 18%;
		filter: blur(22px) saturate(0.9) brightness(0.42) contrast(1.05);
		will-change: transform;
	}

	.layer-a {
		animation: drift-a 26s ease-in-out infinite alternate;
		opacity: 0.95;
	}

	.layer-b {
		animation: drift-b 32s ease-in-out infinite alternate;
		opacity: 0.55;
		transform: scale(1.12);
		filter: blur(32px) saturate(0.75) brightness(0.35);
	}

	.veil {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 90% 70% at 50% 20%, rgba(212, 175, 55, 0.08), transparent 55%),
			linear-gradient(180deg, rgba(5, 6, 8, 0.35) 0%, rgba(5, 6, 8, 0.82) 55%, rgba(5, 6, 8, 0.94) 100%);
	}

	.grain {
		position: absolute;
		inset: 0;
		opacity: 0.06;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
	}

	@keyframes drift-a {
		0% {
			transform: scale(1.06) translate3d(0, 0, 0);
		}
		100% {
			transform: scale(1.16) translate3d(-2.5%, -1.5%, 0);
		}
	}

	@keyframes drift-b {
		0% {
			transform: scale(1.12) translate3d(1%, 0.5%, 0);
		}
		100% {
			transform: scale(1.22) translate3d(-1.5%, 2%, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.layer-a,
		.layer-b {
			animation: none;
		}
	}
</style>
