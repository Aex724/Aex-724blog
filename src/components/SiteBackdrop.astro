---
import { getImage } from 'astro:assets';
import mascot from '../assets/mascot-cn.png';
import { withBase } from '../utils/path';

const poster = await getImage({ src: mascot, width: 720, format: 'webp', quality: 85 });
const videoSrc = withBase('/mascot-loop.webm');
---

<div class="site-backdrop" aria-hidden="true">
	<video class="video-bg" autoplay muted loop playsinline preload="auto" poster={poster.src}>
		<source src={videoSrc} type="video/webm" />
	</video>
	<div class="veil"></div>
</div>

<style>
	.site-backdrop {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		background: #071214;
		pointer-events: none;
	}

	.video-bg {
		position: absolute;
		inset: -4%;
		width: 108%;
		height: 108%;
		object-fit: cover;
		object-position: center 8%;
		filter: blur(1px) brightness(0.78) saturate(1.15) hue-rotate(-8deg);
		opacity: 0.9;
	}

	.veil {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 70% 45% at 50% 18%, rgba(57, 197, 187, 0.16), transparent 55%),
			radial-gradient(ellipse 80% 50% at 50% 72%, rgba(7, 18, 20, 0.05) 0%, rgba(7, 18, 20, 0.68) 72%),
			linear-gradient(180deg, rgba(7, 18, 20, 0.42) 0%, rgba(7, 18, 20, 0.12) 40%, rgba(7, 18, 20, 0.78) 100%);
	}

	@media (prefers-reduced-motion: reduce) {
		.video-bg {
			display: none;
		}

		.site-backdrop {
			background-image: var(--mascot-poster, none);
			background-size: cover;
			background-position: center 10%;
		}
	}
</style>
