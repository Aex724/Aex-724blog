---
import { Image } from 'astro:assets';
import mascot from '../assets/mascot-cn.png';

interface Props {
	line?: string;
	variant?: 'hero' | 'banner';
	bubbleId?: string;
	lineId?: string;
}

const {
	line = '我是本站看板娘，短发异瞳、执剑而行。需要导航请点右侧菜单～',
	variant = 'banner',
	bubbleId,
	lineId,
} = Astro.props;

const isHero = variant === 'hero';
---

<aside class:list={['mascot-showcase', isHero && 'hero']} aria-label="看板娘">
	<div class="bubble" {...bubbleId ? { id: bubbleId } : {}}>
		<p {...lineId ? { id: lineId } : {}}>{line}</p>
	</div>
	<div class="frame">
		<Image
			src={mascot}
			alt="中国风看板娘：短发异瞳，民族服饰，执剑"
			width={isHero ? 420 : 360}
			height={isHero ? 560 : 480}
			class="mascot-img"
			loading="eager"
			decoding="async"
		/>
	</div>
	<p class="caption">看板娘 · 国风执剑</p>
</aside>

<style>
	.mascot-showcase {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.mascot-showcase.hero {
		align-items: center;
	}

	.bubble {
		position: relative;
		max-width: 20rem;
		margin-bottom: 0.65rem;
		padding: 0.75rem 1rem;
		background: linear-gradient(180deg, #fff 0%, #fff7ed 100%);
		border: 2px solid rgba(220, 38, 38, 0.35);
		border-radius: 18px;
		box-shadow: 0 8px 22px rgba(185, 28, 28, 0.12);
		animation: float 3.2s ease-in-out infinite;
	}

	.bubble::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: -9px;
		width: 16px;
		height: 16px;
		background: #fff7ed;
		border-right: 2px solid rgba(220, 38, 38, 0.35);
		border-bottom: 2px solid rgba(220, 38, 38, 0.38);
		transform: translateX(-50%) rotate(45deg);
	}

	.bubble p {
		margin: 0;
		font-size: 0.92rem;
		color: #7f1d1d;
		line-height: 1.55;
	}

	.frame {
		width: min(100%, 280px);
		filter: drop-shadow(0 14px 24px rgba(185, 28, 28, 0.18));
	}

	.hero .frame {
		width: min(100%, 320px);
	}

	.mascot-img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 20px;
		border: 3px solid rgba(254, 243, 199, 0.95);
		outline: 2px solid rgba(220, 38, 38, 0.25);
		background: #fff;
	}

	.caption {
		margin: 0.5rem 0 0;
		font-size: 0.82rem;
		color: #b45309;
		font-family: var(--font-display);
		letter-spacing: 0.08em;
	}

	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
	}
</style>
