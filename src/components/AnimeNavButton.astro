---
import { withBase } from '../utils/path';

interface Props {
	href: string;
	label: string;
	emoji: string;
	hint: string;
	external?: boolean;
}

const { href, label, emoji, hint, external = false } = Astro.props;
const resolved = href.startsWith('http') ? href : withBase(href);
---

<a
	class="nav-btn"
	href={resolved}
	data-hint={hint}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
>
	<span class="emoji" aria-hidden="true">{emoji}</span>
	<span class="label">{label}</span>
	<span class="shine" aria-hidden="true"></span>
</a>

<style>
	.nav-btn {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-height: 5.25rem;
		padding: 1rem 0.75rem;
		border-radius: 16px;
		text-decoration: none;
		color: rgba(236, 253, 250, 0.95);
		background: rgba(14, 36, 40, 0.55);
		border: 1px solid rgba(57, 197, 187, 0.24);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
		overflow: hidden;
		transition:
			transform 0.14s ease,
			border-color 0.14s ease,
			background 0.14s ease,
			box-shadow 0.14s ease;
		cursor: pointer;
		user-select: none;
		backdrop-filter: blur(10px);
	}

	.nav-btn:hover {
		transform: translateY(-2px);
		border-color: rgba(57, 197, 187, 0.55);
		background: rgba(18, 48, 52, 0.72);
		box-shadow: 0 10px 28px rgba(57, 197, 187, 0.16);
	}

	.nav-btn:active {
		transform: translateY(1px);
	}

	.emoji {
		font-size: 1.5rem;
		line-height: 1;
		opacity: 0.95;
	}

	.label {
		font-weight: 600;
		font-size: 0.88rem;
		letter-spacing: 0.1em;
	}

	.shine {
		position: absolute;
		inset: -40% auto auto -30%;
		width: 45%;
		height: 140%;
		background: linear-gradient(90deg, transparent, rgba(57, 197, 187, 0.22), transparent);
		transform: rotate(18deg);
		opacity: 0;
	}

	.nav-btn:hover .shine {
		opacity: 1;
		animation: sweep 0.85s ease;
	}

	@keyframes sweep {
		from {
			left: -40%;
		}
		to {
			left: 120%;
		}
	}
</style>
